<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="repera_today" android:enabled="true"
        android:icon="@drawable/ic_timer"
        android:shortcutShortLabel="@string/shortcut_repera_today"
        android:shortcutLongLabel="@string/shortcut_repera_today_long">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.app.repera"
            android:targetClass="dev.repera.mobile.MainActivity"
            android:data="repera://today" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
