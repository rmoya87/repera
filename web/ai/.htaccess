<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://esm.sh; style-src 'self'; connect-src 'self' https://uvzgujlrqohreoucirms.supabase.co https://esm.sh; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
