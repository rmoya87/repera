# Repera — Apache (IONOS / hosting compartido)
# Sube este archivo junto al resto de `web/` a la raíz del sitio (htdocs).

DirectoryIndex index.html

# No listar directorios
Options -Indexes

# Bloquear basura / archivos de repo no públicos
<FilesMatch "(?i)^(.*\.zip|README\.md|LEEME-SUBIR\.txt|_redirects|_headers|\.DS_Store|pack-ionos\.sh|content/.*|scripts/.*|templates/.*)$">
  Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)^(.*\.zip|README\.md|LEEME-SUBIR\.txt|_redirects|_headers|\.DS_Store|pack-ionos\.sh)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pretty URLs canónicas
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^privacy-en/?$ privacy-en.html [L]
  RewriteRule ^terms/?$ terms.html [L]
  RewriteRule ^faq/?$ faq.html [L]
  RewriteRule ^funcionalidades/?$ funcionalidades.html [L]
  RewriteRule ^casos/?$ casos.html [L]
  RewriteRule ^casos/([a-z0-9-]+)/?$ casos/$1.html [L]
  RewriteRule ^outdoor/?$ outdoor.html [L]
  RewriteRule ^recuperacion/?$ recuperacion.html [L]
  RewriteRule ^ia/?$ ia.html [L]
  RewriteRule ^precios/?$ precios.html [L]
  RewriteRule ^soporte/?$ soporte.html [L]

  # Redirigir .html → URL limpia
  RewriteCond %{THE_REQUEST} \s/+privacy\.html[\s?] [NC]
  RewriteRule ^ /privacy [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+privacy-en\.html[\s?] [NC]
  RewriteRule ^ /privacy-en [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+terms\.html[\s?] [NC]
  RewriteRule ^ /terms [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+faq\.html[\s?] [NC]
  RewriteRule ^ /faq [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+funcionalidades\.html[\s?] [NC]
  RewriteRule ^ /funcionalidades [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+casos\.html[\s?] [NC]
  RewriteRule ^ /casos [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+casos/([a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^ /casos/%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+outdoor\.html[\s?] [NC]
  RewriteRule ^ /outdoor [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+recuperacion\.html[\s?] [NC]
  RewriteRule ^ /recuperacion [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+ia\.html[\s?] [NC]
  RewriteRule ^ /ia [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+precios\.html[\s?] [NC]
  RewriteRule ^ /precios [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+soporte\.html[\s?] [NC]
  RewriteRule ^ /soporte [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "interest-cohort=()"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/json image/svg+xml
  SetEnvIfNoCase Request_URI "\.(?:gif|jpe?g|png|webp|zip|gz)$" no-gzip dont-vary
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
